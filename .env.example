# ChainPay - Environment Variables Template
# Copy this file to '.env' and fill in your network and contract configurations.

# -----------------------------------------------------------------------------
# Stellar & Soroban Network Config
# -----------------------------------------------------------------------------
# Active network passphrase (e.g. "testnet")
VITE_STELLAR_NETWORK="testnet"

# Active Soroban RPC URL
VITE_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Deployed ChainPay payment request contract ID on Stellar Testnet
VITE_PAYMENT_CONTRACT_ID="CDDXP4MWAHLV6TEYVG6I62CBP2INMSJ32Z33BKCBFTOEVSX3BB26WKUB"

# Deployed registry contract ID (optional)
VITE_REGISTRY_CONTRACT_ID=""
